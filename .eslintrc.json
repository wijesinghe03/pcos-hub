{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "Theme": "readonly",
    "Auth": "readonly",
    "Toast": "readonly",
    "L10n": "readonly",
    "PageLoader": "readonly",
    "Stats": "readonly",
    "initNavbar": "readonly",
    "setActiveNav": "readonly",
    "initNewsletter": "readonly",
    "initReveal": "readonly",
    "initCountUps": "readonly",
    "showSection": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }]
  }
}
